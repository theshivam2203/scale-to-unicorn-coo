# Execution mode. Only "demo" is implemented: every external action is simulated.
VITE_EXECUTION_MODE=demo

# NEVER put integration secrets in VITE_* variables — they are bundled into the browser.
# Real credentials (GoHighLevel, Gmail OAuth, n8n webhook secret, Supabase service key,
# LLM API key) belong on a server-side API that the frontend adapters call.
